{
  "buildCommand": "node scripts/runtime-archive-repair.mjs && node scripts/followup-lineage-repair.mjs && node scripts/print-layout-repair.mjs && for test in tests/*.mjs; do node \"$test\"; done",
  "outputDirectory": ".",
  "functions": {
    "api/interpret.js": {
      "memory": 128,
      "maxDuration": 300
    },
    "api/notify.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/webhook.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/redeem.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/qt.html?mode=anon",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/:token([a-z0-9]{8,})", "destination": "/share.html?t=:token" }
  ]
}
