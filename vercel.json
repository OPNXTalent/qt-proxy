{
  "functions": {
    "api/interpret.js": {
      "maxDuration": 300
    },
    "api/notify.js": {
      "maxDuration": 10
    },
    "api/webhook.js": {
      "maxDuration": 10
    },
    "api/redeem.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/qt.html?mode=anon",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/:token([a-z0-9]{8,})",
      "destination": "/share.html?t=:token"
    }
  ]
}
