{
  "buildCommand": "node scripts/run-offline-tests.mjs",
  "outputDirectory": ".",
  "functions": {
    "api/interpret.js": {
      "memory": 128,
      "maxDuration": 300
    },
    "api/notify.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/webhook.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/redeem.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/qt-gateway.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/owner-finance",
      "destination": "/api/transcribe?prism_owner_finance=1"
    },
    {
      "source": "/owner",
      "destination": "/owner-finance.html"
    },
    {
      "source": "/api/client-config",
      "destination": "/api/transcribe?prism_client_config=1"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/:token([a-z0-9]{8,})",
      "destination": "/share.html?t=:token"
    }
  ]
}
